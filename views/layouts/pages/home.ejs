<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Resume Optimizer | AI-Powered Resume Enhancement</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="container nav-container">

            <a href="/" class="logo">
                Resume<span>Optimizer</span>
            </a>

            <div class="nav-links">
                <a href="#features">Features</a>
                <a href="#how-it-works">How It Works</a>
                <a href="#" class="nav-login">Login</a>
                <a href="#" class="nav-btn">Get Started</a>
            </div>

        </div>
    </nav>


    <!-- Hero Section -->
    <section class="hero">
        <div class="container hero-container">

            <div class="hero-content">

                <div class="badge">
                    AI-Powered Resume Optimization
                </div>

                <h1>
                    Build a Resume That
                    <span>Gets Noticed.</span>
                </h1>

                <p class="hero-text">
                    Upload your resume, paste a job description, and let AI
                    analyze, optimize, and generate a job-specific resume
                    designed to improve your chances of getting shortlisted.
                </p>

                <div class="hero-buttons">
                    <a href="#" class="primary-btn">
                        Optimize My Resume
                    </a>

                    <a href="#how-it-works" class="secondary-btn">
                        See How It Works
                    </a>
                </div>

                <div class="hero-note">
                    <span>✓</span> ATS-friendly &nbsp;&nbsp;
                    <span>✓</span> Job-specific &nbsp;&nbsp;
                    <span>✓</span> AI-powered
                </div>

            </div>


            <!-- Hero Card -->
            <div class="hero-card">

                <div class="analysis-header">
                    <div>
                        <p class="small-label">Resume Analysis</p>
                        <h3>Software Engineer Resume</h3>
                    </div>

                    <span class="status">Analyzed</span>
                </div>

                <div class="score-section">
                    <div class="score-circle">
                        <span>87</span>
                        <small>/100</small>
                    </div>

                    <div class="score-content">
                        <h4>Strong Resume</h4>
                        <p>
                            Your resume is well aligned with this job.
                        </p>
                    </div>
                </div>

                <div class="metric">
                    <div class="metric-top">
                        <span>ATS Compatibility</span>
                        <strong>91%</strong>
                    </div>
                    <div class="progress">
                        <div class="progress-fill ats"></div>
                    </div>
                </div>

                <div class="metric">
                    <div class="metric-top">
                        <span>Job Match</span>
                        <strong>84%</strong>
                    </div>
                    <div class="progress">
                        <div class="progress-fill match"></div>
                    </div>
                </div>

                <div class="suggestion">
                    <span class="suggestion-icon">!</span>

                    <div>
                        <strong>3 improvements found</strong>
                        <p>
                            Add relevant keywords and strengthen project impact.
                        </p>
                    </div>
                </div>

            </div>

        </div>
    </section>


    <!-- Trusted / Stats Section -->
    <section class="stats">
        <div class="container stats-container">

            <div class="stat">
                <h3>ATS</h3>
                <p>Friendly optimization</p>
            </div>

            <div class="stat">
                <h3>AI</h3>
                <p>Powered analysis</p>
            </div>

            <div class="stat">
                <h3>1:1</h3>
                <p>Job-specific matching</p>
            </div>

            <div class="stat">
                <h3>PDF</h3>
                <p>Ready to download</p>
            </div>

        </div>
    </section>


    <!-- Features -->
    <section class="section" id="features">

        <div class="container">

            <div class="section-heading">
                <p class="eyebrow">FEATURES</p>

                <h2>
                    Everything you need to
                    <span>optimize your resume</span>
                </h2>

                <p>
                    From resume analysis to automatic generation,
                    Resume Optimizer handles the complete process.
                </p>
            </div>


            <div class="features-grid">

                <div class="feature-card">
                    <div class="feature-number">01</div>
                    <h3>Resume Analysis</h3>
                    <p>
                        Extract and analyze your resume structure,
                        skills, experience, projects, and achievements.
                    </p>
                </div>

                <div class="feature-card">
                    <div class="feature-number">02</div>
                    <h3>ATS Compatibility</h3>
                    <p>
                        Identify formatting and content issues that
                        could reduce your ATS compatibility.
                    </p>
                </div>

                <div class="feature-card">
                    <div class="feature-number">03</div>
                    <h3>Job Match Analysis</h3>
                    <p>
                        Compare your resume against a specific job
                        description and measure the match.
                    </p>
                </div>

                <div class="feature-card">
                    <div class="feature-number">04</div>
                    <h3>Keyword & Skill Gaps</h3>
                    <p>
                        Discover important job-specific keywords and
                        skills that your resume currently misses.
                    </p>
                </div>

                <div class="feature-card">
                    <div class="feature-number">05</div>
                    <h3>AI Content Improvement</h3>
                    <p>
                        Improve weak bullet points, summaries, and
                        project descriptions without inventing facts.
                    </p>
                </div>

                <div class="feature-card">
                    <div class="feature-number">06</div>
                    <h3>Automatic Resume Generation</h3>
                    <p>
                        Generate a polished, job-targeted resume
                        from your analyzed and optimized content.
                    </p>
                </div>

            </div>

        </div>
    </section>


    <!-- How It Works -->
    <section class="section how-section" id="how-it-works">

        <div class="container">

            <div class="section-heading">
                <p class="eyebrow">HOW IT WORKS</p>

                <h2>
                    From existing resume to
                    <span>optimized application</span>
                </h2>

                <p>
                    A simple process designed for candidates applying
                    to real-world jobs.
                </p>
            </div>


            <div class="steps">

                <div class="step">
                    <div class="step-number">1</div>

                    <div>
                        <h3>Upload your resume</h3>
                        <p>
                            Upload your existing PDF or DOCX resume.
                        </p>
                    </div>
                </div>


                <div class="step">
                    <div class="step-number">2</div>

                    <div>
                        <h3>Paste the job description</h3>
                        <p>
                            Tell us which role you are targeting.
                        </p>
                    </div>
                </div>


                <div class="step">
                    <div class="step-number">3</div>

                    <div>
                        <h3>Get intelligent analysis</h3>
                        <p>
                            Review your ATS score, job match,
                            keywords, skills, and improvements.
                        </p>
                    </div>
                </div>


                <div class="step">
                    <div class="step-number">4</div>

                    <div>
                        <h3>Generate your optimized resume</h3>
                        <p>
                            Create a professional, job-specific
                            resume and download it as PDF.
                        </p>
                    </div>
                </div>

            </div>

        </div>
    </section>


    <!-- CTA -->
    <section class="cta-section">

        <div class="container cta-container">

            <div>
                <p class="eyebrow">READY TO START?</p>

                <h2>
                    Turn your resume into
                    <span>your strongest application.</span>
                </h2>

                <p>
                    Stop sending the same resume to every job.
                    Optimize it for the role you actually want.
                </p>
            </div>

            <a href="#" class="primary-btn">
                Optimize My Resume
            </a>

        </div>

    </section>


    <!-- Footer -->
    <footer class="footer">

        <div class="container footer-container">

            <div>
                <a href="/" class="logo">
                    Resume<span>Optimizer</span>
                </a>

                <p>
                    AI-powered resume optimization for candidates.
                </p>
            </div>

            <p class="copyright">
                © 2026 Resume Optimizer. All rights reserved.
            </p>

        </div>

    </footer>

</body>
</html>