                </a>

                <a
                    href="/optimize"
                    class="nav-btn"
                >
                    Get Started
                </a>

            </div>

        </div>

    </nav>


    <!-- ==================================================
         HERO
    ================================================== -->

    <section class="hero">

        <div class="container hero-container">


            <!-- HERO CONTENT -->

            <div class="hero-content">

                <div class="badge">
                    AI-Powered Resume Optimization
                </div>

                <h1>
                    Build a Resume That
