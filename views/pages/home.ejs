<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Resume Optimizer | AI-Powered Resume Enhancement
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <style>

        /* ==================================================
           HERO
        ================================================== */

        .hero {
            padding: 85px 0 65px;
            background:
                radial-gradient(
                    circle at top right,
                    rgba(37, 99, 235, 0.10),
                    transparent 35%
                ),
                linear-gradient(
                    180deg,
                    #f8fbff 0%,
                    #ffffff 100%
                );
            overflow: hidden;
        }

        .hero-container {
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            align-items: center;
            gap: 70px;
        }

        .hero-content {
            max-width: 670px;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 13px;
            border-radius: 999px;
            background: #eff6ff;
            color: #2563eb;
            border: 1px solid #dbeafe;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.3px;
            margin-bottom: 20px;
        }

        .badge::before {
            content: "✦";
            font-size: 13px;
        }

        .hero h1 {
            font-size: clamp(44px, 5vw, 68px);
            line-height: 1.04;
            letter-spacing: -2.4px;
            margin: 0 0 22px;
            color: #0f172a;
        }

        .hero h1 span {
            color: #2563eb;
            display: inline-block;
        }

        .hero-text {
            max-width: 620px;
            font-size: 17px;
            line-height: 1.75;
            color: #64748b;
            margin-bottom: 30px;
        }

        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 24px;
        }

        .hero-buttons .primary-btn {
            padding: 14px 23px;
            font-size: 15px;
            box-shadow: 0 10px 22px rgba(37, 99, 235, 0.16);
        }

        .hero-buttons .secondary-btn {
            padding: 14px 23px;
            font-size: 15px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
        }

        .hero-note {
            display: flex;
            flex-wrap: wrap;
            gap: 17px;
            color: #64748b;
            font-size: 13px;
            font-weight: 600;
        }

        .hero-note span {
            color: #16a34a;
            font-weight: 800;
        }


        /* ==================================================
           HERO ANALYSIS CARD
        ================================================== */

        .hero-card {
            position: relative;
            background: rgba(255, 255, 255, 0.96);
            border: 1px solid #dbe5f0;
            border-radius: 22px;
            padding: 28px;
            box-shadow:
                0 25px 70px rgba(15, 23, 42, 0.10),
                0 4px 15px rgba(37, 99, 235, 0.05);
        }

        .hero-card::before {
            content: "";
            position: absolute;
            top: -10px;
            right: 25px;
            width: 90px;
            height: 90px;
            background: #dbeafe;
            border-radius: 50%;
            filter: blur(25px);
            opacity: 0.65;
            z-index: 0;
        }

        .hero-card > * {
            position: relative;
            z-index: 1;
        }

        .analysis-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 15px;
            padding-bottom: 20px;
            border-bottom: 1px solid #eef2f7;
        }

        .small-label {
            margin: 0 0 5px;
            color: #94a3b8;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.7px;
        }

        .analysis-header h3 {
            margin: 0;
            font-size: 18px;
            color: #0f172a;
        }

        .status {
            display: inline-flex;
            align-items: center;
            padding: 7px 11px;
            border-radius: 999px;
            background: #ecfdf5;
            color: #047857;
            font-size: 11px;
            font-weight: 800;
        }

        .status::before {
            content: "●";
            margin-right: 5px;
            font-size: 8px;
        }


        /* ==================================================
           SCORE
        ================================================== */

        .score-section {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 24px 0;
        }

        .score-circle {
            width: 112px;
            height: 112px;
            min-width: 112px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            background:
                radial-gradient(
                    circle,
                    #ffffff 56%,
                    #eff6ff 57%
                );
            border: 9px solid #bfdbfe;
            box-shadow:
                inset 0 0 0 1px #dbeafe,
                0 8px 18px rgba(37, 99, 235, 0.08);
        }

        .score-circle span {
            font-size: 29px;
            line-height: 1;
            font-weight: 800;
            color: #2563eb;
        }

        .score-circle small {
            margin-top: 4px;
            color: #94a3b8;
            font-size: 11px;
            font-weight: 700;
        }

        .score-content h4 {
            margin: 0 0 7px;
            color: #0f172a;
            font-size: 18px;
        }

        .score-content p {
            margin: 0;
            color: #64748b;
            line-height: 1.55;
            font-size: 14px;
        }


        /* ==================================================
           METRICS
        ================================================== */

        .metric {
            margin-bottom: 18px;
        }

        .metric:last-of-type {
            margin-bottom: 0;
        }

        .metric-top {
            display: flex;
            justify-content: space-between;
            margin-bottom: 7px;
            font-size: 13px;
            color: #475569;
        }

        .metric-top strong {
            color: #0f172a;
        }

        .progress {
            height: 8px;
            border-radius: 999px;
            background: #eef2f7;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            border-radius: inherit;
            background: #2563eb;
        }

        .progress-fill.ats {
            width: 91%;
        }

        .progress-fill.match {
            width: 84%;
        }


        /* ==================================================
           SUGGESTION
        ================================================== */

        .suggestion {
            display: flex;
            gap: 12px;
            margin-top: 24px;
            padding: 15px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 13px;
        }

        .suggestion-icon {
            width: 30px;
            height: 30px;
            min-width: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fef3c7;
            color: #b45309;
            font-weight: 800;
        }

        .suggestion strong {
            display: block;
            margin-bottom: 3px;
            color: #0f172a;
            font-size: 13px;
        }

        .suggestion p {
            margin: 0;
            color: #64748b;
            font-size: 12px;
            line-height: 1.55;
        }


        /* ==================================================
           STATS
        ================================================== */

        .stats {
            padding: 0 0 65px;
            background: #ffffff;
        }

        .stats-container {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        .stat {
            text-align: center;
            padding: 20px 14px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
        }

        .stat h3 {
            margin: 0 0 6px;
            color: #2563eb;
            font-size: 21px;
            font-weight: 800;
        }

        .stat p {
            margin: 0;
            color: #64748b;
            font-size: 13px;
        }


        /* ==================================================
           SECTION HEADINGS
        ================================================== */

        .section-heading {
            max-width: 720px;
            margin: 0 auto 44px;
            text-align: center;
        }

        .section-heading h2 {
            margin-bottom: 14px;
            font-size: clamp(30px, 4vw, 43px);
            letter-spacing: -1px;
        }

        .section-heading h2 span {
            color: #2563eb;
        }

        .section-heading > p:last-child {
            color: #64748b;
            line-height: 1.7;
        }


        /* ==================================================
           FEATURES
        ================================================== */

        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
        }

        .feature-card {
            position: relative;
            padding: 26px;
            min-height: 190px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 17px;
            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease,
                border-color 0.2s ease;
            overflow: hidden;
        }

        .feature-card::after {
            content: "";
            position: absolute;
            bottom: -30px;
            right: -25px;
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: #eff6ff;
            z-index: 0;
        }

        .feature-card > * {
            position: relative;
            z-index: 1;
        }

        .feature-card:hover {
            transform: translateY(-4px);
            border-color: #bfdbfe;
            box-shadow: 0 16px 35px rgba(15, 23, 42, 0.07);
        }

        .feature-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: #eff6ff;
            color: #2563eb;
            font-size: 12px;
            font-weight: 800;
            margin-bottom: 20px;
        }

        .feature-card h3 {
            margin: 0 0 9px;
            font-size: 18px;
            color: #0f172a;
        }

        .feature-card p {
            margin: 0;
            color: #64748b;
            line-height: 1.65;
            font-size: 14px;
        }


        /* ==================================================
           HOW IT WORKS
        ================================================== */

        .how-section {
            background: #f8fafc;
        }

        .steps {
            max-width: 850px;
            margin: 0 auto;
            display: grid;
            gap: 13px;
        }

        .step {
            display: grid;
            grid-template-columns: 48px 1fr;
            align-items: center;
            gap: 18px;
            padding: 18px 20px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 15px;
        }

        .step-number {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #2563eb;
            color: #ffffff;
            font-weight: 800;
            font-size: 14px;
            box-shadow: 0 8px 18px rgba(37, 99, 235, 0.18);
        }

        .step h3 {
            margin: 0 0 5px;
            font-size: 16px;
            color: #0f172a;
        }

        .step p {
            margin: 0;
            color: #64748b;
            line-height: 1.55;
            font-size: 14px;
        }


        /* ==================================================
           CTA
        ================================================== */

        .cta-section {
            padding: 75px 0;
            background:
                radial-gradient(
                    circle at 10% 50%,
                    rgba(59, 130, 246, 0.11),
                    transparent 28%
                ),
                #0f172a;
        }

        .cta-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 35px;
        }

        .cta-container .eyebrow {
            color: #93c5fd;
        }

        .cta-container h2 {
            max-width: 720px;
            margin: 0 0 12px;
            color: #ffffff;
            font-size: clamp(30px, 4vw, 46px);
            letter-spacing: -1px;
        }

        .cta-container h2 span {
            color: #60a5fa;
        }

        .cta-container p:last-child {
            max-width: 620px;
            margin: 0;
            color: #cbd5e1;
            line-height: 1.7;
        }

        .cta-container .primary-btn {
            flex-shrink: 0;
            padding: 14px 24px;
            background: #ffffff;
            color: #1d4ed8;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.18);
        }

        .cta-container .primary-btn:hover {
            background: #eff6ff;
        }


        /* ==================================================
           RESPONSIVE
        ================================================== */

        @media (max-width: 1000px) {

            .hero-container {
                grid-template-columns: 1fr;
                gap: 45px;
            }

            .hero-content {
                max-width: 760px;
                margin: 0 auto;
                text-align: center;
            }

            .hero-buttons,
            .hero-note {
                justify-content: center;
            }

            .hero-card {
                max-width: 620px;
                width: 100%;
                margin: 0 auto;
            }

            .features-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .cta-container {
                flex-direction: column;
                text-align: center;
            }

            .cta-container h2,
            .cta-container p:last-child {
                margin-left: auto;
                margin-right: auto;
            }
        }

        @media (max-width: 700px) {

            .hero {
                padding: 55px 0 45px;
            }

            .hero h1 {
                letter-spacing: -1.4px;
            }

            .hero-text {
                font-size: 15px;
            }

            .stats-container {
                grid-template-columns: repeat(2, 1fr);
            }

            .features-grid {
                grid-template-columns: 1fr;
            }

            .feature-card {
                min-height: auto;
            }

            .cta-section {
                padding: 55px 0;
            }
        }

        @media (max-width: 520px) {

            .score-section {
                align-items: flex-start;
            }

            .score-circle {
                width: 95px;
                height: 95px;
                min-width: 95px;
                border-width: 7px;
            }

            .score-circle span {
                font-size: 24px;
            }

            .analysis-header {
                flex-direction: column;
            }

            .stats-container {
                grid-template-columns: 1fr 1fr;
            }

            .step {
                grid-template-columns: 40px 1fr;
                gap: 13px;
            }

            .step-number {
                width: 38px;
                height: 38px;
            }

        }

    </style>

</head>


<body>


    <!-- ==================================================
         NAVBAR
    ================================================== -->

    <nav class="navbar">

        <div class="container nav-container">

            <a
                href="/"
                class="logo"
            >
                Resume<span>Optimizer</span>
            </a>

            <div class="nav-links">

                <a href="#features">
                    Features
                </a>

                <a href="#how-it-works">
